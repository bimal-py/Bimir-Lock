# The Deliverfile allows you to store various App Store Connect metadata
# For more information, check out the docs
# https://docs.fastlane.tools/actions/deliver/

require 'json'

# --- Authentication -------------------------------------------------------
# App Store Connect API key instead of an Apple ID, so runs are 2FA-free.
# `appstore_api_key.json` is gitignored and holds only identifiers plus the path
# to the .p8; the .p8 itself never enters the repo. It is the same key the
# Callbreak repo uses (/Users/groot/personal_projects/app_keys/).
#
# The path is resolved by search, not by `__dir__`: fastlane `eval`s this file rather
# than loading it from disk, so `__dir__` follows the working directory — which is the
# fastlane folder for raw lane code but its PARENT for actions like `deliver`. One of
# these two candidates is always right.
_key_path = [
  File.expand_path("fastlane/appstore_api_key.json", Dir.pwd),
  File.expand_path("appstore_api_key.json", Dir.pwd)
].find { |p| File.exist?(p) }
if _key_path.nil?
  UI.user_error!("ios/fastlane/appstore_api_key.json is missing — copy it from " \
                 "../callbreaktracker/ios/fastlane/appstore_api_key.json")
end

_key = JSON.parse(File.read(_key_path))
api_key(
  key_id: _key["key_id"],
  issuer_id: _key["issuer_id"],
  filepath: File.expand_path(_key["key_filepath"]),
  in_house: _key.fetch("in_house", false)
)

app_identifier("com.cklamib.bimirLock")

# --- What gets uploaded ---------------------------------------------------
# Binaries ship through Xcode/TestFlight; deliver here is a listing tool only.
skip_binary_upload(true)

# Text metadata lives in ios/fastlane/metadata/<locale>/, screenshots in
# ios/fastlane/screenshots/<locale>/. deliver infers each screenshot's device
# class from its pixel dimensions, so one flat folder per locale is enough.
# It REPLACES a locale's screenshot set rather than merging into it.
skip_screenshots(false)
overwrite_screenshots(true)

# The App Privacy "nutrition label", age rating and pricing are answered in App
# Store Connect by hand (see listing/v2/STORE_SETUP.md); deliver does not touch them.

# precheck can't inspect in-app purchases with API-key auth, and nothing is
# auto-submitted here anyway.
run_precheck_before_submit(false)

# --- Safety ---------------------------------------------------------------
# Changes land as a draft in App Store Connect for a human to review and submit.
submit_for_review(false)
automatic_release(false)

